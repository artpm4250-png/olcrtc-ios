<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FUTURE-SIGNING entitlements file. NOT attached to any current build
  configuration in project.yml — Xcode would refuse to build unsigned
  because com.apple.developer.networking.networkextension requires a
  matching provisioning profile. See ADR-0008 in
  docs/ai/DECISIONS.md.

  When a signing identity becomes available, attach this file by
  adding the following to the OlcRTCClient target's settings.base in
  project.yml and regenerating the project:

      CODE_SIGN_ENTITLEMENTS: Sources/App/OlcRTCClient.entitlements

  Real-device VPN runtime requires:
    - a paid Apple Developer account,
    - a provisioning profile that includes the
      com.apple.developer.networking.networkextension entitlement,
    - the App Group below registered on the developer portal,
    - a signed build.

  None of the above are configured today. Do not treat the presence of
  this file as evidence that the app can install and run a VPN on a
  stock iPhone.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.org.openlibrecommunity.olcrtc.client</string>
    </array>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
</dict>
</plist>
