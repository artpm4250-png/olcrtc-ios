<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FUTURE-SIGNING entitlements file for the PacketTunnelProvider
  extension. NOT attached to any current build configuration in
  project.yml — same reason as Sources/App/OlcRTCClient.entitlements.
  See ADR-0008 in docs/ai/DECISIONS.md.

  When a signing identity becomes available, attach this file by
  adding the following to the PacketTunnelProvider target's
  settings.base in project.yml and regenerating the project:

      CODE_SIGN_ENTITLEMENTS: Sources/PacketTunnelProvider/PacketTunnelProvider.entitlements
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.org.openlibrecommunity.olcrtc.client</string>
    </array>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
</dict>
</plist>
